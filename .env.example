# capstone/.env.example
# Copy to capstone/.env and fill in your own values.
# Secrets are left empty; the rest are the defaults ai/config.py falls back to.

# --- Gemini: LLM + embeddings (required) -----------------------------
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=models/gemini-embedding-001

# --- Qdrant: cloud URL optional, embedded path used otherwise --------
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=capstone_docs
MEMORY_COLLECTION=capstone_memory

# --- SQLite: text-to-SQL (F5) -----------------------------------------
SQLITE_PATH=data/company.db

# --- Optional: web search (F4) -----------------------------------------
TAVILY_API_KEY=

# --- Optional: observability (F12) --------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Graph safety limits (F9) -------------------------------------------
MAX_REVISIONS=2
RECURSION_LIMIT=25

# --- Agent tuning ---------------------------------------------------------
RETRIEVER_K=4
MEMORY_K=3
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
CODE_TIMEOUT_SECONDS=15
